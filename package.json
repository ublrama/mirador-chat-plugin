{
  "name": "mirador-chat-plugin",
  "version": "1.0.0",
  "description": "Mirador 4 plugin for asking questions about manifests using semantic search and LLM",
  "module": "./dist/mirador-chat-plugin.es.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./src": "./src/index.js",
    ".": {
      "import": "./dist/mirador-chat-plugin.es.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.js",
    "build:demo": "vite build --config vite.config.demo.js",
    "clean": "rm -rf ./dist ./dist-demo",
    "start": "vite",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mirador",
    "plugin",
    "llm",
    "semantic-search",
    "question-answering",
    "iiif"
  ],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "mirador": "^4.0.0",
    "prop-types": "^15.7.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "mirador": "^4.0.0",
    "prop-types": "^15.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {}
}
