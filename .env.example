# Copy this file to .env and fill in your values before running docker-compose.

# ── Containerised Ollama (optional) ──────────────────────────────────────────
# To spin up an Ollama container alongside the app, set all three values below:
#
#   USE_OLLAMA=true
#   COMPOSE_PROFILES=ollama
#   OLLAMA_MODEL=qwen3-vl:4b
#
# Then run:  docker compose up --build
#
# The model is pulled automatically on first start (may take several minutes).
# Leave USE_OLLAMA=false and COMPOSE_PROFILES commented out (the defaults) to
# use any other LiteLLM provider instead — Ollama will not be started.
USE_OLLAMA=false
OLLAMA_MODEL=qwen3-vl:4b
# Uncomment the line below (and set USE_OLLAMA=true) to start the Ollama container:
#COMPOSE_PROFILES=ollama

# ── LLM model (LiteLLM model string) ─────────────────────────────────────────
# Ignored when USE_OLLAMA=true (OLLAMA_MODEL is used instead).
# Default: gpt-5.4-mini (OpenAI). Change to any LiteLLM-supported model.
# Examples:
#   LLM_MODEL=gpt-5.4-mini
#   LLM_MODEL=gemini/gemini-3.5-flash
#   LLM_MODEL=ollama/llama3  (external Ollama; set OLLAMA_API_BASE too)
LLM_MODEL=gpt-5.4-mini

# ── Provider credentials ──────────────────────────────────────────────────────
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=


# Azure OpenAI (optional)
#AZURE_API_KEY=...
#AZURE_API_BASE=https://<your-resource>.openai.azure.com
#AZURE_API_VERSION=2024-02-01

# Ollama base URL (optional).
# When USE_OLLAMA=true this defaults to http://ollama:11434 (the container).
# For an external Ollama instance set this explicitly, e.g.:
#   OLLAMA_API_BASE=http://host.docker.internal:11434
#OLLAMA_API_BASE=

# ── Debugging ─────────────────────────────────────────────────────────────────
#LITELLM_VERBOSE=true
