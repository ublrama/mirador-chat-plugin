# Copy this file to .env and fill in your values before running docker-compose.

# ── Containerised Ollama (optional) ──────────────────────────────────────────
# Set USE_OLLAMA=true to spin up an Ollama container alongside the app.
# The backend will automatically route requests to it.
# OLLAMA_MODEL controls which model is pulled and used (default: qwen3-vl:4b).
#
# IMPORTANT: also set COMPOSE_PROFILES=ollama so Docker Compose starts the
# Ollama service:
#
#   USE_OLLAMA=true
#   COMPOSE_PROFILES=ollama
#   OLLAMA_MODEL=qwen3-vl:4b
#
# Then run:  docker compose up --build
#
# The model is pulled automatically on first start (may take several minutes).
# Leave USE_OLLAMA=false (the default) to use any other LiteLLM provider below.
USE_OLLAMA=false
OLLAMA_MODEL=qwen3-vl:4b
#COMPOSE_PROFILES=ollama

# ── LLM model (LiteLLM model string) ─────────────────────────────────────────
# Ignored when USE_OLLAMA=true (OLLAMA_MODEL is used instead).
# Default: gpt-4o-mini (OpenAI). Change to any LiteLLM-supported model.
# Examples:
#   LLM_MODEL=gpt-4o
#   LLM_MODEL=anthropic/claude-3-haiku-20240307
#   LLM_MODEL=ollama/llama3  (external Ollama; set OLLAMA_API_BASE too)
LLM_MODEL=gpt-4o-mini

# ── Provider credentials ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Anthropic (optional)
#ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (optional)
#AZURE_API_KEY=...
#AZURE_API_BASE=https://<your-resource>.openai.azure.com
#AZURE_API_VERSION=2024-02-01

# Ollama base URL (optional).
# When USE_OLLAMA=true this defaults to http://ollama:11434 (the container).
# For an external Ollama instance set this explicitly, e.g.:
#   OLLAMA_API_BASE=http://host.docker.internal:11434
#OLLAMA_API_BASE=

# ── Debugging ─────────────────────────────────────────────────────────────────
#LITELLM_VERBOSE=true
