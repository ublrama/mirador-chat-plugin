# Copy this file to .env and fill in your values before running docker-compose.

# ── LLM model (LiteLLM model string) ─────────────────────────────────────────
# Default: gpt-4o-mini (OpenAI). Change to any LiteLLM-supported model.
# Examples:
#   LLM_MODEL=gpt-4o
#   LLM_MODEL=anthropic/claude-3-haiku-20240307
#   LLM_MODEL=ollama/llama3
LLM_MODEL=gpt-4o-mini

# ── Provider credentials ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Anthropic (optional)
#ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (optional)
#AZURE_API_KEY=...
#AZURE_API_BASE=https://<your-resource>.openai.azure.com
#AZURE_API_VERSION=2024-02-01

# Ollama local instance (optional, defaults to host.docker.internal:11434)
#OLLAMA_API_BASE=http://host.docker.internal:11434

# ── Debugging ─────────────────────────────────────────────────────────────────
#LITELLM_VERBOSE=true
