# API endpoint for the chat backend.
# The plugin appends /<item-id>/stream for internal (Leiden) manifests
# and /external for manifests hosted elsewhere.
# When this is not set (or the backend is unreachable) the plugin falls back
# to a built-in mock streaming API.
VITE_API_ENDPOINT=/api/chat

# ── WebLLM in-browser inference (optional) ───────────────────────────────────
# Set to "true" to enable the in-browser AI mode powered by WebLLM / WebGPU.
# When enabled, the UI shows a "Load model" button; once loaded, questions are
# answered locally on the user's GPU without any backend call.
# Note: requires a WebGPU-capable browser (Chrome 113+, Edge 113+).
# Note: the model weights are downloaded from the MLC CDN on first use (~0.5–7 GB
# depending on the model) and cached in the browser's Cache Storage.
#VITE_WEBLLM_ENABLED=true

# Vision-capable model to use for in-browser inference.
# Any model ID supported by @mlc-ai/web-llm can be used here.
# Smaller models (<2 B) work on integrated GPUs; vision models require more VRAM.
# Defaults to Llama-3.2-1B-Instruct-q4f16_1-MLC when not set.
#VITE_WEBLLM_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC
